# Шлюз API и раздача SPA (architecture.md §3).
# Внутренние порты сервисов (8081) сюда не проксируются никогда (D31).

# Балансировка между копиями сервиса (docker compose up --scale <сервис>=N): адреса берутся из DNS Docker
# и обновляются каждые 5 с; упавшая копия на время исключается, запрос повторяется на другой (architecture.md §8).
(upstream) {
	dynamic a {args[0]} {args[1]} {
		refresh 5s
	}
	lb_policy round_robin
	lb_try_duration 5s
	lb_try_interval 250ms
	fail_duration 30s
	unhealthy_status 502 503
}

(protected) {
	# Личность проверяет auth; при успехе его заголовки копируются в запрос к сервису (D26)
	forward_auth {
		import upstream auth 8081
		uri /internal/verify
		copy_headers X-User-Id X-User-Role X-Faculty-Id
	}
	reverse_proxy {
		import upstream {args[0]} 8080
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	import security_headers

	# Ответы с ошибками Caddy идут мимо обычной цепочки — заголовки нужны и им
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}

	# Заголовки личности снаружи не принимаются: их выставляет только auth (security.md §3)
	request_header -X-User-Id
	request_header -X-User-Role
	request_header -X-Faculty-Id

	# Внутренний API не доступен снаружи даже по подобранному адресу
	@internal path_regexp ^/api/[^/]+/internal(/|$)
	handle @internal {
		respond 404
	}

	# Без проверки сессии
	handle /api/auth/login {
		uri strip_prefix /api/auth
		reverse_proxy {
			import upstream auth 8080
		}
	}
	handle /api/auth/logout {
		uri strip_prefix /api/auth
		reverse_proxy {
			import upstream auth 8080
		}
	}
	handle /api/requests/public/* {
		uri strip_prefix /api/requests
		reverse_proxy {
			import upstream requests 8080
		}
	}

	# С проверкой сессии
	handle_path /api/auth/* {
		import protected auth
	}
	handle_path /api/academic/* {
		import protected academic
	}
	handle_path /api/requests/* {
		import protected requests
	}
	handle_path /api/notifications/* {
		import protected notifications
	}
	handle_path /api/assistant/* {
		import protected assistant
	}
	handle /api/* {
		respond 404
	}

	# SPA: неизвестные пути отдают index.html, роутинг делает фронтенд
	# Файлы сборки с хешем в имени кэшируются на год, index.html — всегда перепроверяется:
	# после выкладки браузер сразу получает новую версию, а повторные визиты почти ничего не качают.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
