# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пароли — длинные случайные строки, например: openssl rand -hex 24

# Адрес сайта для Caddy: localhost — локально (самоподписанный сертификат), домен — на сервере (Let's Encrypt)
SITE_ADDRESS=localhost

# Суперпользователь PostgreSQL (только для создания баз; сервисы им не пользуются)
POSTGRES_PASSWORD=

# У каждого сервиса своя база и свой пользователь (D27)
AUTH_DB_PASSWORD=
ACADEMIC_DB_PASSWORD=
REQUESTS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
